# Hosted store (needed on Vercel). Set automatically when you connect a Blob store or Upstash Redis to the project.
BLOB_READ_WRITE_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Where the JSON database lives when no Redis is set. Default .data/db.json. On Docker, put it on a mounted volume.
DATA_FILE=
SITE_URL=http://localhost:3000

# Email (https://resend.com). Empty = emails are printed to the server log.
RESEND_API_KEY=
FROM_EMAIL=Matchday <onboarding@resend.dev>

# Protects /api/cron. Make it long and random.
CRON_SECRET=

# Run reminders inside the app every 5 min (always-on server). Leave unset on Vercel and use cron-job.org.
SCHEDULER=

# Device notifications: run `npm run vapid` and paste the output here.
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
