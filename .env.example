# Postgres. Leave empty in dev to use an embedded database in .data/
DATABASE_URL=
SITE_URL=http://localhost:3000

# Email (https://resend.com). Empty = emails are printed to the server log.
RESEND_API_KEY=
FROM_EMAIL=Matchday <onboarding@resend.dev>

# Protects /api/cron. Make it long and random.
CRON_SECRET=

# Run reminders inside the app every 5 min (always-on server). Leave unset on Vercel and use cron-job.org.
SCHEDULER=

# Device notifications: run `npm run vapid` and paste the output here.
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
